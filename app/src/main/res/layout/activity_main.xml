<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
    <TextView android:id="@+id/tvAppVersion" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ЧЗ: Наборы" android:textSize="18sp" android:paddingTop="7dp" android:paddingBottom="7dp" android:textIsSelectable="true" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ScrollView android:id="@+id/profilePage" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/tvConnection" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ПК не подключён" android:textSize="14sp" android:paddingTop="7dp" android:paddingBottom="7dp" android:textIsSelectable="true" />
                <Button android:id="@+id/btnConnectPc" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Подключить ПК / QR" android:minHeight="48dp" />
                <TextView android:id="@+id/tvProfileHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1. Организация и шаблон" android:textSize="18sp" android:paddingTop="7dp" android:paddingBottom="7dp" android:textIsSelectable="true" />
                <Spinner android:id="@+id/spinnerProfiles" android:layout_width="match_parent" android:layout_height="48dp" />
                <TextView android:id="@+id/tvProfileSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Выберите сохранённый профиль" android:textSize="15sp" android:paddingTop="6dp" android:paddingBottom="6dp" />
                <Button android:id="@+id/btnStartWork" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Начать работу" android:minHeight="48dp" />
                <Button android:id="@+id/btnEditProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Настроить профиль" android:minHeight="48dp" />
                <LinearLayout android:id="@+id/profileEditor" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <EditText android:id="@+id/etProfileTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Название профиля: Кириешки 6 / ИП" android:inputType="text" android:minLines="1" android:minHeight="48dp" android:gravity="top|start" />
                    <EditText android:id="@+id/etInn" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="ИНН организации или ИП" android:inputType="number" android:minLines="1" android:minHeight="48dp" android:gravity="top|start" />
                    <Spinner android:id="@+id/spinnerEnvironment" android:layout_width="match_parent" android:layout_height="48dp" />
                    <TextView android:id="@+id/tvProductGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Товарная группа: grocery — сухарики и майонезы. ОСУ." android:textSize="14sp" android:paddingTop="7dp" android:paddingBottom="7dp" android:textIsSelectable="true" />
                    <EditText android:id="@+id/etSetGtin" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="GTIN самого набора: 14 цифр" android:inputType="number" android:minLines="1" android:minHeight="48dp" android:gravity="top|start" />
                    <TextView android:id="@+id/tvCompositionHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Состав из карточки набора в Национальном каталоге. Каждая строка: GTIN=количество. Например: 04607010740016=1" android:textSize="14sp" android:paddingTop="7dp" android:paddingBottom="7dp" android:textIsSelectable="true" />
                    <EditText android:id="@+id/etComposition" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="GTIN=количество, каждый GTIN с новой строки" android:inputType="textMultiLine|textNoSuggestions" android:minLines="4" android:minHeight="48dp" android:gravity="top|start" />
                    <Button android:id="@+id/btnSaveProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Сохранить профиль и состав" android:minHeight="48dp" />
                    <Button android:id="@+id/btnDeleteProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Удалить выбранный профиль" android:minHeight="48dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <ScrollView android:id="@+id/workPage" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/tvWorkProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Профиль зафиксирован" android:textSize="17sp" android:paddingTop="6dp" android:paddingBottom="6dp" />
                <Button android:id="@+id/btnBackProfiles" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Выйти к выбору профиля" android:minHeight="48dp" />
                <TextView android:id="@+id/tvScanState" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Сканируйте код набора" android:textSize="17sp" android:paddingTop="7dp" android:paddingBottom="7dp" android:textIsSelectable="true" />
                <Button android:id="@+id/btnFlow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="СТАРТ потока" android:minHeight="48dp" />
                <TextView android:id="@+id/tvFlowState" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Поток на паузе" android:textSize="14sp" android:paddingTop="6dp" android:paddingBottom="6dp" />
                <TextView android:id="@+id/tvScanHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Текущий набор" android:textSize="18sp" android:paddingTop="7dp" android:paddingBottom="7dp" android:textIsSelectable="true" />
                <TextView android:id="@+id/tvCurrentSet" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Текущий набор не открыт" android:textSize="14sp" android:paddingTop="7dp" android:paddingBottom="7dp" android:textIsSelectable="true" />
                <TextView android:id="@+id/tvProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Пачек: 0" android:textSize="14sp" android:paddingTop="7dp" android:paddingBottom="7dp" android:textIsSelectable="true" />
                <EditText android:id="@+id/etScanInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Поле сканера в режиме клавиатуры" android:inputType="textNoSuggestions" android:minLines="1" android:minHeight="48dp" android:gravity="top|start" android:imeOptions="actionDone" android:singleLine="true" />
                <Button android:id="@+id/btnScan" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Одиночное сканирование" android:minHeight="48dp" />
                <Button android:id="@+id/btnResetCurrentSet" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Сбросить только текущий незавершённый набор" android:minHeight="48dp" />
                <TextView android:id="@+id/tvQueueHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Очередь выбранного профиля" android:textSize="18sp" android:paddingTop="7dp" android:paddingBottom="7dp" android:textIsSelectable="true" />
                <TextView android:id="@+id/tvTotalCompletedSets" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Готовых наборов: 0" android:textSize="14sp" android:paddingTop="7dp" android:paddingBottom="7dp" android:textIsSelectable="true" />
                <Button android:id="@+id/btnSendDraft" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Передать наборы этого профиля на ПК" android:minHeight="48dp" />
                <Button android:id="@+id/btnRefresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Обновить статусы с ПК" android:minHeight="48dp" />
                <TextView android:id="@+id/tvNoSignature" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="На ПК проверьте состав и нажмите «Подписать и отправить в ЧЗ». Без подтверждения наборы остаются в очереди." android:textSize="14sp" android:paddingTop="7dp" android:paddingBottom="7dp" android:textIsSelectable="true" />
                <TextView android:id="@+id/tvQueue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Очередь пуста" android:textSize="14sp" android:paddingTop="7dp" android:paddingBottom="7dp" android:textIsSelectable="true" />
                <Button android:id="@+id/btnBackup" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Экспорт резервной копии очереди" android:minHeight="48dp" />
                <Button android:id="@+id/btnCheckUpdate" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Об обновлении приложения" android:minHeight="48dp" />
                <Button android:id="@+id/btnShareLog" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Поделиться журналом" android:minHeight="48dp" />
                <TextView android:id="@+id/tvLog" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Журнал работы" android:textSize="12sp" android:paddingTop="7dp" android:paddingBottom="7dp" android:textIsSelectable="true" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>