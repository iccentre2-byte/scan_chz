<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:padding="12dp">

    <!-- Заголовок и кнопка обновления -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ЧЗ: Сборка Наборов"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <Button
            android:id="@+id/btnCheckUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Обновить"
            android:textSize="11sp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:id="@+id/tvAppVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.0.9"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#2563EB"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Профиль -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Профиль организации"
                        android:textStyle="bold"
                        android:textColor="#0F172A"
                        android:layout_marginBottom="6dp"/>

                    <Spinner
                        android:id="@+id/spinnerProfiles"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginBottom="6dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="ИНН организации"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etInn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Bearer Token (из ЛК ЧЗ)"
                        android:layout_marginTop="4dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etToken"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Товарная группа ЧЗ (pg):"
                        android:textSize="12sp"
                        android:textColor="#475569"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="2dp"/>

                    <Spinner
                        android:id="@+id/spinnerPg"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginBottom="4dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Свой код pg"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etProductGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:text="grocery" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">

                        <Button
                            android:id="@+id/btnSaveProfile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Сохранить"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                        <Button
                            android:id="@+id/btnDeleteProfile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="Удалить"
                            android:textColor="#DC2626"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Шаблон -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. Шаблон комплектации"
                        android:textStyle="bold"
                        android:textColor="#0F172A"
                        android:layout_marginBottom="6dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Количество пачек в одном наборе"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCountPerSet"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="6" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Статус -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tvScanState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="СТАТУС: Отсканируйте DataMatrix НАБОРА"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="#1D4ED8"
                        android:background="#EFF6FF"
                        android:padding="6dp"/>

                    <TextView
                        android:id="@+id/tvCurrentSet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Текущий набор: НЕ ВЫБРАН"
                        android:textColor="#334155"
                        android:layout_marginTop="6dp"/>

                    <TextView
                        android:id="@+id/tvProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Пачек в наборе: 0 / 6"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#047857"
                        android:layout_marginTop="2dp"/>

                    <TextView
                        android:id="@+id/tvTotalCompletedSets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Закрытых наборов к отправке: 0"
                        android:textStyle="bold"
                        android:textColor="#0F172A"
                        android:layout_marginTop="2dp"/>

                    <Button
                        android:id="@+id/btnResetCurrentSet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Сбросить текущий набор"
                        android:layout_marginTop="6dp"
                        android:textColor="#DC2626"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btnSendDraft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ЗАКРЫТЬ НАБОРЫ И ОТПРАВИТЬ ЧЕРНОВИК В ЧЗ"
                android:backgroundTint="#047857"
                android:padding="10dp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

    <!-- Вынесенное окно лога -->
    <TextView
        android:id="@+id/tvLog"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="8dp"
        android:background="#0F172A"
        android:textColor="#34D399"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:padding="8dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:text="--- Лог работы ТСД v1.0.9 ---\n"/>

</LinearLayout>
